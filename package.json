{
  "name": "sad-creeper",
  "version": "1.0.0",
  "private": true,
  "description": "A Probot app to check for a valid server version output in newly created issues.",
  "keywords": [
    "github",
    "probot",
    "probot-app"
  ],
  "homepage": "https://github.com/timbru31/sad-creeper",
  "bugs": "https://github.com/timbru31/sad-creeper/issues",
  "license": "MIT",
  "author": "Tim Prüssing <github@timbrust.de>",
  "repository": "https://github.com/timbru31/sad-creeper.git",
  "type": "module",
  "exports": "./index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc && (tsc -w --preserveWatchOutput & node --watch --watch-path=.env --watch-path=.github/config.yml --watch-kill-signal=SIGINT --watch-preserve-output ./node_modules/probot/bin/probot.js run ./lib/index.js)",
    "dev": "pnpm run build:watch",
    "start": "pnpm run build && probot run ./lib/index.js",
    "lint": "oxlint --fix",
    "format": "oxfmt --ignore-path .oxfmtignore",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore",
    "test": "vitest run && oxlint",
    "test:watch": "vitest --coverage"
  },
  "dependencies": {
    "@probot/get-private-key": "^2.1.1",
    "probot": "^13.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/node": "^5.10.2",
    "@vitest/coverage-v8": "^5.0.5",
    "nock": "^15.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
