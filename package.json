{
  "name": "sad-creeper",
  "version": "1.0.0",
  "type": "module",
  "exports": "./index.js",
  "private": true,
  "description": "A Probot app to check for a valid server version output in newly created issues.",
  "author": "Tim Brust <github@timbrust.de>",
  "license": "MIT",
  "repository": "https://github.com/timbru31/sad-creeper.git",
  "homepage": "https://github.com/timbru31/sad-creeper",
  "bugs": "https://github.com/timbru31/sad-creeper/issues",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc && (tsc -w --preserveWatchOutput & nodemon)",
    "dev": "npm run build:watch",
    "start": "npm run build && probot run ./lib/index.js",
    "lint": "eslint **/*.ts --fix",
    "test": "vitest run && eslint **/*.ts",
    "test:watch": "vitest --coverage"
  },
  "dependencies": {
    "@probot/get-private-key": "^2.1.1",
    "probot": "^13.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^26.6.6",
    "@vercel/node": "^5.10.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nock": "^14.0.15",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "smee-client": "^4.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
